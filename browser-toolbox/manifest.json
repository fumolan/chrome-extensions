{
  "manifest_version": 3,
  "name": "浏览器工具箱",
  "version": "1.3.0",
  "description": "开发常用小工具集合：JWT 解析等，持续集成新工具。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "浏览器工具箱",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": ["contextMenus", "storage"]
}
