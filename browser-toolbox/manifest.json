{
  "manifest_version": 3,
  "name": "浏览器工具箱",
  "version": "1.13.2",
  "description": "开发常用小工具集合：JWT 解析、JSON 格式化、时间、定位、二维码等，持续集成新工具。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "浏览器工具箱",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": ["contextMenus", "storage", "geolocation"],
  "host_permissions": ["https://restapi.amap.com/*"]
}
