{
  "manifest_version": 3,
  "name": "Word Catcher 生词本",
  "version": "1.4.0",
  "description": "与 IDEA 插件 Word Catcher 共享同一生词本：网页取词（右键 / Alt+Shift+W）、生词高亮、卡片自测、导出 CSV。需 IDEA 在运行。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Word Catcher 生词本",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:18091/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["highlight.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "capture-word": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "把选中的单词记入生词本（与 IDEA 同快捷键）"
    }
  }
}
