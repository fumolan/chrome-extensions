# ============================================================
# rich-notes 服务器配置模板：复制为 .env 后按实际环境填写
# ============================================================

# 数据库驱动：sqlite | postgres | mysql
DB_DRIVER=sqlite

# 监听端口
PORT=3001

# SQLite 数据库文件路径（仅 sqlite 模式）
# DB_FILE=notes.db

# PostgreSQL 连接串（仅 postgres 模式；目标库不存在时自动创建）
# DATABASE_URL=postgres://用户名:密码@localhost:5432/rich_notes

# MySQL 连接串（仅 mysql 模式；目标库不存在时自动创建）
# DATABASE_URL=mysql://用户名:密码@localhost:3306/rich_notes
