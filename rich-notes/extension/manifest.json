{
  "manifest_version": 3,
  "name": "富文本笔记 (Rich Notes)",
  "version": "1.6.3",
  "description": "富文本编辑 + 数据库存储：默认使用浏览器内置数据库 IndexedDB，也可在设置中切换连接自建 REST 服务器（Node.js + SQLite）。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开富文本笔记"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
